{
  "name": "resume",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:portable": "tsc -b && node scripts/build-portable.mjs",
    "analyze": "node scripts/analyze.mjs",
    "format": "prettier --write src scripts docs *.json *.ts *.md index.html .prettierrc.json",
    "format:check": "prettier --check src scripts docs *.json *.ts *.md index.html .prettierrc.json",
    "lint": "node scripts/check-architecture.mjs",
    "check": "npm run format:check && npm run analyze && npm run lint"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^14.9.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.5",
    "rough-notation": "^0.5.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "terser": "^5.51.2",
    "typescript": "~5.7.3",
    "vite": "^6.4.1"
  }
}
